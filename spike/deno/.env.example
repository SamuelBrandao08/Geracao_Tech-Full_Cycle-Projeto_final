# Copie para .env e ajuste: cp .env.example .env
# O .env NÃO deve ser commitado (veja .gitignore).

POSTGRES_USER=spike_user
POSTGRES_PASSWORD=troque_esta_senha
POSTGRES_DB=spike_db
# Mude se a 5432 já estiver ocupada na sua máquina (ex.: 5433).
POSTGRES_PORT=5432

# Usada pelo db.ts. Deve repetir usuário, senha, porta e banco acima.
# Use senha sem caracteres especiais (@ : / ?), ou codifique-os na URL.
DATABASE_URL=postgres://spike_user:troque_esta_senha@localhost:5432/spike_db
