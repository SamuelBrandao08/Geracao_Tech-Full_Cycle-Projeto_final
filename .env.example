# Configuração do PostgreSQL (Docker Compose e execução local)
POSTGRES_USER=biblioteca
POSTGRES_PASSWORD=troque_esta_senha_local
POSTGRES_DB=biblioteca
POSTGRES_PORT=5432

# URL de conexão direta usada pelo Deno em execução e testes locais
DATABASE_URL=postgres://biblioteca:troque_esta_senha_local@localhost:5432/biblioteca

# Configurações da Aplicação (API Fastify + Ed25519)
PORT=3000
LOG_LEVEL=info
SIGNING_KEY_ID=key-2026-01